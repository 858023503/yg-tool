  const logs = ['=== 动态刷怪配置生成（' + r.engine + ' 引擎）===', '地图 ' + r.maps + ' 个 / 记录 ' + r.records + ' 条（' + r.spawnCmd + ' 补怪）',
    'RobotManage + AutoRunRobot 已写入（不改造原 MonGen）', '提示: 动态刷怪数据已经处理成功，请重启M2生效'];
  if (r.qm) logs.push(r.qm.msg);
  return { log: logs };
});

