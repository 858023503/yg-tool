  if (!r.ok) return { log: [r.msg] };
  return { log: ['=== 原刷怪调整完成 ===', '刷新数量调整 ' + r.changedCount + ' 行 / 刷新时间调整 ' + r.changedDate + ' 行', '文件: ' + r.file] };
});

ipcMain.handle('dynamic-spawn', (e, o) => {
