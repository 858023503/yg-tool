;TOOL_STORE_TIMER_START
[@OnTimer51]
#IF
#ACT
MOV S$用户数据存储地址 ..\..\..\..\通区文件\测试1区\<$USERID>_<$USERNAME>.ini
MOV N$背包存储_定时开关 0
ReadConfigFileItem S$用户数据存储地址 商店 背包存储定时 N$背包存储_定时开关

#IF
EQUAL N$背包存储_定时开关 1
#ACT
#CALL [\商店功能\商店.txt] @开启背包存储
#IF
NOT EQUAL N$背包存储_定时开关 1
#ACT
SetOffTimer 51
BREAK
;TOOL_STORE_TIMER_END
