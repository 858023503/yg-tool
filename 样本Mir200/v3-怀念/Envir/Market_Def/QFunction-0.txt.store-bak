[@SAA]
\ \ \

<>       < ┄┈━≡★装备指定人物爆出发射系统★≡━┈┄/AUTOCOLOR=254,251,168,191,250,70,245,249,253>\ \
　<请输入玩家名字/@@InPutString34>：<$STR(S34)>　\ \
　<请输入装备名字/@@InPutString35>：<$STR(S35)>　\ \
　<请输入怪物名字/@@InPutString36>：<$STR(S36)>　\ \
　<确定发射/@确定爆率>　\ \

[@InPutString34]
#if
checkonline <$STR(S34)>
#ACT
GOTO @SAA
BREAK
#ELSEACT
