[@确定爆率]
#if
checkonline <$STR(S34)>
#ACT
;MOV  A99 <$STR(S34)>
;MOV  A100 <$STR(S35)>
;MOV  A101 <$STR(S36)>
SetHumVar <$STR(S34)> S$指定名字 <$STR(S34)> 
SetHumVar <$STR(S34)> S$指定装备 <$STR(S35)> 
SetHumVar <$STR(S34)> S$指定怪物 <$STR(S36)> 
MESSAGEBOX 设置给玩家【<$STR(S34)>】必爆【<$STR(S35)>】完毕！
GOTO @SAA
BREAK
#ELSEACT
MESSAGEBOX 对方不在线
BREAK
[@DummyStop]
#IF  
ISDUMMY
NOT ISONMAP <$GLOBAL(假人_盟重地图号)>
CHECKLEVELEX > 35
#ACT
setontimer 255 55
SetOnTimer 201 20
SetOnTimer 203 30
movr N$X <$GLOBAL(假人_回城坐标X左)> <$GLOBAL(假人_回城坐标X右)>
movr N$Y <$GLOBAL(假人_回城坐标Y左)> <$GLOBAL(假人_回城坐标Y右)>
mapmove <$GLOBAL(假人_盟重地图号)> <$str(N$X)> <$str(N$Y)>
DUMMYSTOP
ChangeAttatckMode 6
movr N$XX <$GLOBAL(假人_回城坐标X左)> <$GLOBAL(假人_回城坐标X右)>
movr N$YY <$GLOBAL(假人_回城坐标Y左)> <$GLOBAL(假人_回城坐标Y右)>
GOTONOW <$str(N$XX)> <$str(N$YY)>
HUMANHP = <$MAXHP>
HUMANMP = <$MAXMP>
MOVR N$下图 3 8
MOVR N$频率 5 9
SETONTIMER 202 <$STR(N$频率)>
break

