mov N$虾米资源编号 123
ADDBUTTON <$STR(N$虾米资源编号)> 200 10 11 12 10 92 1 -1

#IF
NOT ISDUMMY
ISNEWHUMAN
#ACT
#CALL [\商店功能\创建文件.txt] @创建文件
