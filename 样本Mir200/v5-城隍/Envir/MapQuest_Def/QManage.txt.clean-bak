[@Login]

;TOOL_INJECTED_START
;存销写入记录结束,请勿删除,元歌工具箱
#IF
NOT ISDUMMY
#ACT
#CALL [\商店功能\存销变量初始化.txt] @存销变量初始化
mov S$用户数据存储地址 ..\..\..\..\通区文件\城隍\<$USERID>_<$USERNAME>.ini
mov S$物品数据存储地址 ..\..\..\..\通区文件\城隍\物品数据\
mov S$地图数据存储地址 ..\..\..\..\通区文件\城隍\地图数据\
mov S$本地物品数据存储地址 ..\QuestDiary\武器\
