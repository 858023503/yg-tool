  adjustItem, adjustRateFile, globalAdjust,
  convertRandomFile, globalConvert, m2Reload, M2_RELOAD_ITEMS,
  readPortConfig, writePortConfig, replacePorts,
  readItemDesc, writeItemDesc, addItemDesc, delItemDesc, readUnbindList, writeUnbindList, addUnbindItem, delUnbindItem, readShopList, readGroupItems,
