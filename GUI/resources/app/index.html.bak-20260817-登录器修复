<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>元歌工具箱</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Microsoft YaHei", sans-serif; background: #eef1f6; color: #333; display: flex; min-height: 100vh; font-size: 14.5px; }

  /* ===== 左侧导航栏 ===== */
  .sidebar {
    width: 232px; min-width: 232px; background: linear-gradient(180deg, #f6f8fc 0%, #e9eef7 100%);
    color: #34405a; display: flex; flex-direction: column; position: sticky; top: 0; height: 100vh; overflow-y: auto;
    border-right: 1px solid #dbe2ee;
  }
  .sidebar .logo { padding: 22px 20px 16px; border-bottom: 1px solid #dbe2ee; }
  .sidebar .logo h1 { font-size: 17px; color: #1b2a45; letter-spacing: 1px; }
  .sidebar .logo .sub { font-size: 11px; color: #6b7c9b; margin-top: 4px; }
  .sidebar nav { flex: 1; padding: 10px 0; }
  .sidebar nav .nav-group { font-size: 11px; color: #8a97b0; padding: 12px 20px 4px; letter-spacing: 2px; }
  .sidebar nav button {
    display: flex; align-items: center; gap: 10px; width: 100%; padding: 10px 20px; border: none; background: none;
    color: #3d4b66; font-size: 13.5px; cursor: pointer; text-align: left; border-left: 3px solid transparent;
    transition: all .15s;
  }
  .sidebar nav button .ic { font-size: 15px; width: 22px; text-align: center; }
  .sidebar nav button:hover { background: rgba(22,119,255,.08); color: #1677ff; }
  .sidebar nav button.active { background: #1677ff; color: #fff; border-left-color: #0d5fc7; }
  .sidebar .footer { padding: 14px 20px; font-size: 11px; color: #5c6b84; border-top: 1px solid rgba(255,255,255,.07); }

  /* ===== 右侧内容区 ===== */
  .content { flex: 1; padding: 20px 26px; min-width: 0; }
  .topbar { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; flex-wrap: wrap; }
  .topbar h2 { font-size: 19px; color: #1f2d3d; }
  .topbar .root-box { display: flex; align-items: center; gap: 8px; margin-left: auto; flex-wrap: wrap; }
  .topbar .root-box input { width: 320px; max-width: 40vw; }

  .card { background: #fff; border-radius: 10px; padding: 18px 20px; box-shadow: 0 2px 8px rgba(30,50,90,.06); border: 1px solid #e8ecf2; }
  .card h4 { font-size: 13.5px; color: #445; margin: 6px 0 12px; }
  .card hr { border: none; border-top: 1px solid #eef1f5; margin: 14px 0; }
  .row { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; }
  label { min-width: 90px; font-size: 15px; color: #445; }
  .hint { font-size: 13px !important; }
  .hint { font-size: 13px !important; }
  input[type=text], input[type=number] {
    flex: 1; min-width: 120px; padding: 8px 11px; border: 1px solid #d8dee8; border-radius: 6px; font-size: 14px; background: #fafbfd; transition: border .15s;
  }
  select { min-width: 90px; padding: 8px 11px; border: 1px solid #d8dee8; border-radius: 6px; font-size: 14px; background: #fafbfd; transition: border .15s; }
  input:focus, select:focus { outline: none; border-color: #1677ff; background: #fff; box-shadow: 0 0 0 3px rgba(22,119,255,.1); }
  input[type=number] { max-width: 110px; }
  button { padding: 8px 16px; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; transition: all .15s; }
  .btn-primary { background: #1677ff; color: #fff; }
  .btn-primary:hover { background: #3c8cff; }
  .btn-default { background: #fff; color: #333; border: 1px solid #d8dee8; }
  .btn-default:hover { border-color: #1677ff; color: #1677ff; }
  .btn-danger { background: #dc3545; color: #fff; }
  .btn-danger:hover { background: #e5535f; }
  .btn-warn { background: #fa8c16; color: #fff; }
  .btn-warn:hover { background: #ffa940; }

  .seg { display: flex; gap: 0; border: 1px solid #d8dee8; border-radius: 6px; overflow: hidden; background: #f4f6fa; }
  .seg button { border: none; background: transparent; padding: 7px 14px; font-size: 13px; border-radius: 0; }
  .seg button.active { background: #1677ff; color: #fff; }
  .seg button:not(.active):hover { background: #e8edf6; }

  .hint { font-size: 12px; color: #9aa4b5; margin-top: 4px; }
  .box { background: #1b2230; color: #d4d9e2; border-radius: 8px; padding: 12px; font-family: Consolas, monospace; font-size: 12.5px; max-height: 300px; overflow: auto; white-space: pre-wrap; margin-top: 4px; }

  .panel { display: none; }
  .panel.active { display: block; animation: fadein .18s ease; }
  @keyframes fadein { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

  .content { flex: 1; padding: 16px 26px 8px; min-width: 0; display: flex; flex-direction: column; min-height: 0; }
  .panels-wrap { flex: 1; overflow-y: auto; min-height: 0; padding-right: 6px; padding-bottom: 200px; }
  #log { background: #1b2230; color: #d4d9e2; border-radius: 8px; padding: 8px 10px; font-family: Consolas, monospace; font-size: 12.5px; white-space: pre-wrap; }
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-thumb { background: #c4ccd8; border-radius: 4px; }
  ::-webkit-scrollbar-track { background: transparent; }
  /* 变量查询选中高亮（色差） */
  .vq-type:hover, .vq-var:hover, .vq-ref:hover { background: #eef3ff; }
  .vq-type.active, .vq-var.active { background: #1677ff !important; color: #fff !important; }
  .vq-type.active span, .vq-var.active span { color: #fff !important; }
  .vq-ref.active { background: #e6f4ff !important; color: #1677ff !important; }
  /* placeholder 显示不全优化（全局） */
  input::placeholder { font-size: 12px; color: #8a93a6; opacity: 1; }
  .hint { white-space: normal; line-height: 1.5; }
</style>
</head>
<body>

<!-- ===== 左侧导航 ===== -->
<aside class="sidebar">
  <div class="logo">
    <h1>⚙ 元歌工具箱</h1>
    <div class="sub">传奇服务端工具箱</div>
  </div>
  <nav>
    <div class="nav-group">⚡ 快捷操作</div>
    <button data-nav="npctool"><span class="ic">⚡</span>快捷操作</button>
    <div class="nav-group">💎 爆率系统</div>
    <button data-nav="adjust"><span class="ic">📦</span>爆率调整</button>
    <button data-nav="bulk"><span class="ic">📊</span>批量调整</button>
    <button data-nav="random"><span class="ic">🎲</span>随机转换</button>
    <button data-nav="mapview"><span class="ic">🗺️</span>按地图查看</button>
    
    <div class="nav-group">👹 刷怪系统</div>
    <button data-nav="mongen"><span class="ic">👹</span>刷怪配置</button>
    <button data-nav="robot"><span class="ic">🤖</span>机器人脚本</button>
    <div class="nav-group">💰 货币系统</div>
    <button data-nav="currency"><span class="ic">💰</span>货币消耗</button>
    <button data-nav="exchange"><span class="ic">🔄</span>货币兑换</button>
    <button data-nav="recycle"><span class="ic">♻️</span>回收NPC</button>
    <div class="nav-group">🛠 服务端工具</div>
    <button data-nav="search"><span class="ic">📝</span>脚本搜索</button>
    <button data-nav="inject"><span class="ic">📥</span>脚本注入</button>
    <button data-nav="sync"><span class="ic">📡</span>目录同步</button>
    <button data-nav="login"><span class="ic">🔧</span>登录器配置</button>
    <button data-nav="varquery"><span class="ic">🔎</span>变量查询</button>
    <div class="nav-group">🗂 存销系统</div>
    <button data-nav="sales"><span class="ic">🗂️</span>存销系统</button>
    <div class="nav-group">⚙️ 服务端配置</div>
    <button data-nav="portcfg"><span class="ic">🔧</span>端口配置</button>
    <button data-nav="itemcfg"><span class="ic">🎒</span>物品管理</button>
    <button data-nav="mapcfg"><span class="ic">🗺️</span>地图配置</button>
    <div class="nav-group">🩺 诊断检查</div>
    <button data-nav="engineck"><span class="ic">🔍</span>引擎健检</button>
    <button data-nav="compare"><span class="ic">🔀</span>文件对比</button>
    <button data-nav="health"><span class="ic">🏥</span>一键体检</button>
    <div class="nav-group">🚀 开区部署</div>
    <button data-nav="site"><span class="ic">🌐</span>开区网站</button>
  </nav>
  <div class="footer">GBK/ANSI 编码自动识别</div>
</aside>

<!-- ===== 右侧内容 ===== -->
<main class="content">
  <div class="topbar">
    <h2 id="page-title">快捷操作</h2>
    <div class="root-box">
      <input type="text" id="root" placeholder="服务端根 / Mir200 / Envir 任一层，如 D:\Mirserver">
      <button class="btn-default" id="btn-dir">📁 浏览…</button>
      <select id="root-hist" title="历史引擎根目录（记住上次选择）" style="max-width:200px;"><option value="">历史版本…</option></select>
      <button class="btn-default" id="btn-root-del" title="删除选中的历史项">🗑</button>
      <button class="btn-warn" id="btn-backup">备份 MonItems</button>
    </div>
  </div>
  <div class="panels-wrap">

  <!-- ① 爆率调整 -->
  

<div class="panel" id="panel-adjust">
    <div class="card">
      <div class="row">
        <label>操作范围</label>
        <div class="seg" id="scope-seg">
          <button data-scope="all" class="active">全服</button>
          <button data-scope="mon">指定怪物</button>
          <button data-scope="map">按地图</button>
          <button data-scope="goods">按物品(加在物品后)</button>
        </div>
      </div>
      <div class="row" id="row-mon" style="display:none;">
        <label>怪物名</label>
        <input type="text" id="mon" placeholder="例如 白野猪 / 祖玛教主">
      </div>
      <div class="row" id="row-map" style="display:none;">
        <label>地图代码</label>
        <input type="text" id="map" placeholder="MonGen.txt 地图代码，如 shuai209 / Q004">
        <span class="hint">从 MonGen.txt 查该地图刷的怪</span>
      </div>
      <div class="row" id="row-gitem" style="display:none;">
        <label>目标物品</label>
        <input type="text" id="gitem" placeholder="加在哪个物品后（全服查找）">
        <label style="min-width:auto;">追加物品</label>
        <input type="text" id="gnew" placeholder="追加什么物品">
      </div>
      <div class="row">
        <label>操作类型</label>
        <div class="seg" id="op-seg">
          <button data-op="add" class="active">追加爆率</button>
          <button data-op="del">删除爆率</button>
        </div>
      </div>
      <div class="row" id="row-item">
        <label>物品名</label>
        <input type="text" id="item" placeholder="例如 屠龙 / 裁决之杖">
      </div>
      <div class="row">
        <label>爆率类型</label>
        <div class="seg" id="cat-seg">
          <button data-cat="normal" class="active">普通爆率 1/N</button>
          <button data-cat="child">随机 #CHILD 1/N</button>
          <button data-cat="range">#CHILD 区间</button>
        </div>
      </div>
      <div class="row" id="row-rate">
        <label>爆率</label>
        <input type="number" id="rate" value="100" min="1" placeholder="每 N 只掉 1 个">
        <label style="min-width:auto;">数量</label>
        <input type="number" id="count" value="1" min="1" placeholder="最多掉几个">
      </div>
      <div class="row" id="row-range" style="display:none;">
        <label>随机区间</label>
        <input type="number" id="range-start" placeholder="开始(如10)">
        <label style="min-width:auto;">~</label>
        <input type="number" id="range-end" placeholder="结束(如100)">
        <span class="hint">N 在区间内随机，生成 #CHILD 1/N</span>
      </div>
      <div class="row">
        <button class="btn-primary" id="btn-run" style="margin-left:84px;">执行修改</button>
      </div>
      <div class="hint">追加 = 在爆率文件末尾加一行；删除 = 移除所有该物品条目。操作前建议先备份。</div>
      <div class="card" style="margin-top:16px;">
        <h4>⚡ 整体爆率优化（还原自虾米：筛选目标 + 范围匹配 + 运算）</h4>
        <div class="row">
          <label>目标</label>
          <select id="oo-method" style="width:110px;">
            <option value="all">全服</option>
            <option value="monster">按怪物</option>
            <option value="map">按地图</option>
            <option value="item">按物品</option>
          </select>
          <input type="text" id="oo-target" placeholder="目标名（逗号分隔；全服留空）" style="flex:1;">
        </div>
        <div class="row">
          <label>范围筛选</label>
          <select id="oo-range-op" style="width:80px;"><option value="">不过滤</option><option value=">">大于</option><option value="<">小于</option><option value="=">等于</option></select>
          <input type="number" id="oo-range-val" placeholder="分母阈值（如 50）" style="width:180px;">
        </div>
        <div class="row">
          <label>运算</label>
          <select id="oo-op" style="width:80px;"><option value="mul">乘</option><option value="add">加</option><option value="sub">减</option><option value="div">除</option><option value="set">设</option></select>
          <input type="number" id="oo-op-val" placeholder="数值（如 2）" style="width:180px;">
          <button class="btn-primary" id="oo-run">执行整体优化</button>
        </div>
        <div class="row">
          <label>备份/还原</label>
          <button class="btn" id="oo-backup">📦 备份爆率</button>
          <select id="oo-restore" style="flex:1;"><option value="">选择备份还原…</option></select>
          <button class="btn" id="oo-restore-btn">↩ 还原</button>
        </div>
        <div class="hint">执行前自动备份到 MonItems\@backup\；处理时自动跳过备份目录（还原自虾米）。范围/运算作用于爆率分母（1/x 的 x）。</div>
      </div>
      <div class="card" style="margin-top:16px;">
        <h4>📥 批量新增爆率（还原自虾米：物品列表一次加到全服/指定怪）</h4>
        <div class="row">
          <label>物品</label>
          <input type="text" id="ar-items" placeholder="物品名，逗号分隔，如: 屠龙,裁决之杖" style="flex:1;">
          <input type="number" id="ar-rate" placeholder="分母 1/x" style="width:90px;" value="100">
        </div>
        <div class="row">
          <label>目标</label>
          <select id="ar-method" style="width:90px;"><option value="all">全服</option><option value="monster">指定怪</option></select>
          <input type="text" id="ar-monsters" placeholder="怪名（逗号分隔，全服留空）" style="flex:1;">
          <button class="btn-primary" id="ar-run">批量新增</button>
        </div>
        <div class="hint">自动备份到 @backup\；新增格式 1/{分母}\t{物品名}</div>
      </div>
      <div class="card" style="margin-top:16px;">
        <h4>🔗 #CALL 还原（还原自虾米：解析 MonItems 里的 #CALL 引用，防目录穿越/防备份）</h4>
        <div class="row">
          <button class="btn" id="cr-scan">🔍 扫描 #CALL</button>
          <button class="btn-primary" id="cr-apply">↩ 展开 #CALL</button>
          <div class="hint" id="cr-result" style="flex:1;">扫描 MonItems 中 #CALL 引用（防穿越/防备份校验）</div>
        </div>
      </div>
      <div class="card" style="margin-top:16px;">
        <h4>🗑 指定删除（还原自虾米：按内容全服删除，自动备份）</h4>
        <div class="row">
          <input type="text" id="dr-content" placeholder="物品名（完全匹配）/ 片段 / 正则" style="flex:1;">
          <select id="dr-method" style="width:90px;"><option value="item">完全匹配</option><option value="contain">包含</option><option value="regex">正则</option></select>
          <button class="btn-primary" id="dr-run">指定删除</button>
        </div>
        <div class="hint">删除所有怪物爆率中匹配的物品条目；操作前自动备份</div>
      </div>
      <div class="card" style="margin-top:16px;">
        <h4>🗂 普通爆率分组（还原自虾米：按组大小合并成 #CHILD RANDOM 组）</h4>
        <div class="row">
          <label>每组</label>
          <input type="number" id="gr-size" value="5" min="2" style="width:70px;">
          <label>条</label>
          <button class="btn-primary" id="gr-run">执行分组</button>
          <div class="hint" style="flex:1;">散落普通爆率按 N 条一组包成 #CHILD 1/1 RANDOM（不改变概率）</div>
        </div>
      </div>
      <div class="card" style="margin-top:16px;">
        <h4>✨ 二级爆率优化（还原自虾米：整理 #CHILD 结构——去重/清空组）</h4>
        <div class="row">
          <button class="btn-primary" id="op-run">执行优化</button>
          <div class="hint" style="flex:1;">合并重复物品、删除空 #CHILD 组、展平未闭合括号</div>
        </div>
      </div>
    </div>
  </div>


  <!-- ② 批量调整 -->
  <div class="panel" id="panel-bulk">
    <div class="card">
      <div class="row">
        <label>调整范围</label>
        <div class="seg" id="bulk-scope-seg">
          <button data-bs="all" class="active">全服调整</button>
          <button data-bs="mon">按怪物名称</button>
          <button data-bs="map">按地图</button>
        </div>
      </div>
      <div class="row" id="row-bmon" style="display:none;">
        <label>怪物名</label>
        <input type="text" id="bmon" placeholder="例如 白野猪">
      </div>
      <div class="row" id="row-bmap" style="display:none;">
        <label>地图代码</label>
        <input type="text" id="bmap" placeholder="MonGen.txt 地图代码">
      </div>
      <div class="row">
        <label>调整类型</label>
        <div class="seg" id="bulk-type-seg">
          <button data-bt="normal" class="active">普通爆率 1/*</button>
          <button data-bt="child">随机爆率 #CHILD 1/*</button>
        </div>
      </div>
      <div class="row">
        <label>倍率</label>
        <input type="number" id="b-rate" value="0.5" step="0.1" placeholder="如 0.5：1/100→1/50">
      </div>
      <div class="row">
        <label>最小爆率</label>
        <input type="number" id="b-min" placeholder="≥多少才调整（留空=不限）">
        <label style="min-width:auto;">最大爆率</label>
        <input type="number" id="b-max" placeholder="≤多少才调整（留空=不限）">
      </div>
      <div class="row">
        <label>上限限定</label>
        <input type="number" id="b-limit" placeholder="超出此值的限定为此值（留空=不限）">
      </div>
      <div class="row">
        <button class="btn-primary" id="btn-bulk" style="margin-left:84px;">开始调整爆率</button>
      </div>
      <div class="hint">如输入 0.5，原爆率 1/100 计算结果 100×0.5=50，调整后为 1/50。最小值限定 1，最大值限定 90000000。</div>
    </div>
  </div>

  <!-- ③ 随机转换 -->
  <div class="panel" id="panel-random">
    <div class="card">
      <div class="row">
        <label>转换范围</label>
        <div class="seg" id="rnd-scope-seg">
          <button data-rs="all" class="active">全服转换</button>
          <button data-rs="mon">按怪物名称</button>
          <button data-rs="map">按地图</button>
        </div>
      </div>
      <div class="row" id="row-rmon" style="display:none;">
        <label>怪物名</label>
        <input type="text" id="rmon" placeholder="例如 白野猪">
      </div>
      <div class="row" id="row-rmap" style="display:none;">
        <label>地图代码</label>
        <input type="text" id="rmap" placeholder="MonGen.txt 地图代码">
      </div>
      <div class="row">
        <label>优化范围</label>
        <div class="seg" id="rnd-filter-seg">
          <button data-rf="all" class="active">全部普通爆率</button>
          <button data-rf="ge100">只优化 ≥100 爆率</button>
          <button data-rf="le1000">只优化 ≤1000 爆率</button>
        </div>
      </div>
      <div class="row">
        <button class="btn-primary" id="btn-random" style="margin-left:84px;">转换为随机爆率（#CHILD）</button>
      </div>
      <div class="hint">把符合条件的普通爆率（如 屠龙 1/100 1）转换为随机子项格式（#CHILD 1/100 1），用于减少垃圾爆率。</div>
    </div>
  </div>

  <!-- ④ 按地图查看 -->
  <div class="panel" id="panel-mapview">
    <div class="card">
      <div class="row">
        <label>地图代码</label>
