        <input type="text" id="cm-a" placeholder="如 D:\版本1\Mir200" style="flex:1;">
        <button class="btn" id="cm-ba">浏览</button>
      </div>
      <div class="row">
        <label>目录B</label>
        <input type="text" id="cm-b" placeholder="如 D:\版本2\Mir200" style="flex:1;">
        <button class="btn" id="cm-bb">浏览</button>
      </div>
      <div class="row">
        <button class="btn-primary" id="cm-run">开始对比</button>
        <span class="hint">还原自虾米"文件对比"：仅A/仅B/相同/差异文件+行级对比</span>
      </div>
    </div>
  </div>

  <!-- 一键体检 -->
  <div class="panel" id="panel-health">
    <div class="card">
      <div class="row">
        <label>一键体检</label>
        <button class="btn-primary" id="ht-run">运行体检</button>
        <span class="hint">整合引擎识别+核心文件+目录键+端口一致性+DB端口（一键发现问题）</span>
      </div>
      <div class="row">
        <span id="ht-result" style="flex:1;font-family:Consolas,monospace;font-size:13px;white-space:pre-wrap;color:#c0392b;"></span>
      </div>
    </div>
  </div>

  <!-- 开区网站 -->
  <div class="panel" id="panel-site">
    <div class="card">
      <div class="row">
        <label>网站标题</label>
        <input type="text" id="st-title" placeholder="留空自动读游戏名" style="flex:1;">
      </div>
      <div class="row">
        <label>皮肤</label>
        <select id="st-skin" style="width:160px;">
          <option value="dark">暗夜(红)</option>
          <option value="gold">金色</option>
          <option value="blue">蓝色</option>
          <option value="green">绿色</option>
          <option value="light">明亮</option>
        </select>
      </div>
      <div class="row">
        <label>新区</label>
        <input type="text" id="st-new" placeholder="用逗号分隔，如: 新区1,新区2" style="flex:1;">
      </div>
      <div class="row">
        <label>快餐服</label>
        <input type="text" id="st-fast" placeholder="用逗号分隔" style="flex:1;">
      </div>
      <div class="row">
        <label>单职业</label>
        <input type="text" id="st-solo" placeholder="用逗号分隔" style="flex:1;">
      </div>
      <div class="row">
        <label>站点简介</label>
        <input type="text" id="st-desc" placeholder="开区简介，如: 经典怀旧 长期稳定" style="flex:1;">
      </div>
      <div class="row">
        <label>下载地址</label>
        <input type="text" id="st-dl" placeholder="登录器下载链接（留空不显示下载按钮）" style="flex:1;">
      </div>
      <div class="row">
        <label>QQ群</label>
        <input type="text" id="st-qq" placeholder="多个群号用逗号分隔，如: 123456,789012（自动生成一键加群）" style="flex:1;">
      </div>
      <div class="row">
        <label>开区版本</label>
        <input type="text" id="st-versions" placeholder="逗号分隔，如: 新区1,新区2" style="flex:1;">
      </div>
      <div class="row">
        <label>公告</label>
        <input type="text" id="st-announce" placeholder="逗号分隔的公告内容" style="flex:1;">
      </div>
      <div class="row">
        <label>维护模式</label>
        <label class="check"><input type="checkbox" id="st-maint"> 开启维护（首页横幅 + 独立维护页）</label>
      </div>
      <div class="row">
        <label>维护提示</label>
        <input type="text" id="st-maintmsg" placeholder="维护提示文字（可空）" style="flex:1;">
      </div>
      <div class="row">
        <label>后台管理</label>
        <label class="check"><input type="checkbox" id="st-admin"> 生成后台页（admin.html 编辑→导出配置→发布）</label>
      </div>
      <div class="row">
        <button class="btn-primary" id="st-run">生成网站</button>
        <button class="btn-outline" id="st-apply">🚀 从后台配置发布</button>
        <button class="btn-outline" id="st-preview">👁 预览站点</button>
        <span class="hint">还原自虾米"网站管理"：多页面 + 爆率查询 + 地图走法 + 后台发布 + 维护页</span>
      </div>
      </div>
    <div class="card" style="margin-top:14px;">
      <h4>📡 远端同步（移植自虾米 1.3.6：工具箱间同步爆率查询数据）</h4>
      <div class="row">
        <label>本机接口</label>
        <input type="text" id="sr-local-port" value="8000" style="width:90px;" title="本机接收端口（需开外网访问）">
        <label>本机密钥</label>
        <input type="text" id="sr-local-token" placeholder="接收端校验用（建议设置）" style="width:160px;">
        <button class="btn-default" id="sr-listen">▶ 启动接收</button>
        <button class="btn-default" id="sr-stop">⏹ 停止</button>
        <span class="hint" id="sr-status"></span>
      </div>
      <div class="row">
        <label>远端地址</label>
        <input type="text" id="sr-peer-url" placeholder="如 http://192.168.1.6:8000" style="flex:1;">
        <label>远端密钥</label>
        <input type="text" id="sr-peer-token" placeholder="对方工具箱的本机密钥" style="width:160px;">
        <button class="btn-primary" id="sr-push">📤 同步到远端</button>
        <span class="hint">对方需已启动接收服务</span>
      </div>
    </div>
  </div>


    </div>
  </div>



</div>
</div>
</main>

<div id="log-wrap" style="position:fixed;bottom:10px;right:22px;left:236px;z-index:9999;border:1px solid #33405a;border-radius:8px;box-shadow:0 -2px 12px rgba(20,30,60,.18);">
    <div id="log-handle" style="background:#1b2230;color:#d4d9e2;border-radius:7px 7px 0 0;padding:6px 12px;font-size:12px;cursor:move;user-select:none;display:flex;justify-content:space-between;border-bottom:1px solid #33405a;">
      <span>📋 操作日志（按住拖动位置 / 右下角拉伸大小）</span>
      <span id="log-min" style="cursor:pointer;">— 收起</span>
    </div>
    <div id="log" style="resize:both;overflow:auto;min-height:100px;max-height:60vh;padding:8px 10px;background:#1b2230;color:#d4d9e2;font-family:Consolas,monospace;font-size:12.5px;white-space:pre-wrap;border-radius:0 0 7px 7px;">== 操作日志 ==
所有功能执行结果都会显示在这里</div>
    <script src="renderer.js"></script>
  <!-- 自定义确认模态框（替代 window.confirm：Electron confirm 弹窗后焦点/输入法不恢复会卡输入框，自绘模态无此问题） -->
  <div id="confirm-mask" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(15,23,42,.45);z-index:9999;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:12px;padding:20px 24px;width:min(440px,90vw);box-shadow:0 12px 40px rgba(0,0,0,.28);">
      <div id="confirm-title" style="font-size:15px;font-weight:600;color:#1b2a45;margin-bottom:10px;">⚠️ 请确认</div>
      <div id="confirm-msg" style="font-size:13px;color:#3d4b66;line-height:1.7;white-space:pre-wrap;max-height:280px;overflow-y:auto;margin-bottom:18px;"></div>
      <div style="display:flex;justify-content:flex-end;gap:10px;">
        <button id="confirm-cancel" style="padding:7px 18px;border:1px solid #d0d7e5;border-radius:6px;background:#fff;color:#3d4b66;cursor:pointer;font-size:13px;">取消</button>
        <button id="confirm-ok" style="padding:7px 18px;border:none;border-radius:6px;background:#1677ff;color:#fff;cursor:pointer;font-size:13px;">确认</button>
      </div>
    </div>
  </div>
</body>
</html>
